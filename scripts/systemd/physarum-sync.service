[Unit]
Description=Physarum: Garmin sync + findings + daily brief
Documentation=https://github.com/arczhi/physarum
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=physarum
Group=physarum
EnvironmentFile=/etc/physarum/physarum.env
WorkingDirectory=/opt/physarum
ExecStart=/opt/physarum/.venv/bin/phy daily --json
StandardOutput=append:/var/log/physarum/daily.json
StandardError=append:/var/log/physarum/daily.err
# the model key and the tokens are the only sensitive inputs
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/physarum /var/log/physarum
NoNewPrivileges=true
