# Bodymesh runtime environment. Copy to /etc/bodymesh/bodymesh.env (or export it)
# and keep it OUT of git. Nothing here is required except the Garmin tokens.

# --- storage ---
# BODYMESH_HOME=/var/lib/bodymesh
# BODYMESH_DB=/var/lib/bodymesh/bodymesh.db
# BODYMESH_INBOX=/var/lib/bodymesh/inbox

# --- Garmin Connect ---
# Directory holding garmin_tokens.json produced by `garmin-mcp-auth` or python-garminconnect.
GARMINTOKENS=/var/lib/bodymesh/.garminconnect
GARMIN_IS_CN=true

# --- model (food-photo estimation; optional but strongly recommended) ---
BODYMESH_LLM_KEY=sk-replace-me
BODYMESH_LLM_BASE=https://api.deepseek.com
BODYMESH_CHAT_MODEL=deepseek-v4-pro
BODYMESH_VISION_MODEL=deepseek-flash

# --- personalisation (all optional) ---
BODYMESH_TZ=Asia/Shanghai
BODYMESH_SLEEP_NEED_H=8
# BODYMESH_WEIGHT_KG=96.8
# BODYMESH_GOAL_WEIGHT_KG=85
