# Physarum runtime environment. Copy to /etc/physarum/physarum.env (or export it)
# and keep it OUT of git. Nothing here is required except the Garmin tokens.

# --- storage ---
# PHYSARUM_HOME=/var/lib/physarum
# PHYSARUM_DB=/var/lib/physarum/physarum.db
# PHYSARUM_INBOX=/var/lib/physarum/inbox

# --- Garmin Connect ---
# Directory holding garmin_tokens.json produced by `garmin-mcp-auth` or python-garminconnect.
GARMINTOKENS=/var/lib/physarum/.garminconnect
GARMIN_IS_CN=true

# --- model (food-photo estimation; optional but strongly recommended) ---
PHYSARUM_LLM_KEY=sk-replace-me
PHYSARUM_LLM_BASE=https://api.deepseek.com
PHYSARUM_CHAT_MODEL=deepseek-v4-pro
PHYSARUM_VISION_MODEL=deepseek-flash

# --- personalisation (all optional) ---
PHYSARUM_TZ=Asia/Shanghai
PHYSARUM_SLEEP_NEED_H=8
# PHYSARUM_WEIGHT_KG=96.8
# PHYSARUM_GOAL_WEIGHT_KG=85
